DB_USER=pillpipe
DB_PASSWORD=changeme
DB_NAME=pillpipe
VAPID_PUBLIC_KEY=generate_with_web-push_library
VAPID_PRIVATE_KEY=generate_with_web-push_library
VAPID_EMAIL=mailto:admin@pillpipe.local
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# --- Authentication (required: the backend refuses to start without APP_PASSWORD_HASH) ---
# Generate with: docker compose run --rm backend node scripts/hash-password.js
APP_PASSWORD_HASH=
# Optional (defaults shown). TTLs are in seconds.
# SESSION_IDLE_TTL=604800
# SESSION_ABS_TTL=2592000
# COOKIE_SECURE=false        # true behind HTTPS (production default)
# APP_ORIGIN=https://pillpipe.example.com   # exact public origin; enables the Origin check
# LOGIN_MAX_FAILS=5
